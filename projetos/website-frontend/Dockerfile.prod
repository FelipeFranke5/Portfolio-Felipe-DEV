# ============================================================
#  website-frontend/Dockerfile.prod
#  Build multi-stage: compila o Angular em modo produção e serve
#  o resultado estático com NGINX. Usado pelo docker-compose.prod.yml.
#  A configuração de proxy/SSL fica fora da imagem, montada via
#  volume (ver nginx/nginx.prod.conf), para poder ser editada sem
#  rebuild.
# ============================================================

# ---------- Stage 1: build ----------
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build -- --configuration production


# ---------- Stage 2: runtime ----------
FROM nginx:alpine AS runtime

COPY --from=build /app/dist/website-frontend/browser /usr/share/nginx/html
COPY nginx-entrypoint.sh /usr/local/bin/nginx-entrypoint.sh
RUN chmod +x /usr/local/bin/nginx-entrypoint.sh

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://localhost/ >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/nginx-entrypoint.sh"]
